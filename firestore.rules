rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && 'role' in myDoc() && myDoc().role == 'admin';
    }
    function canManageTopics() {
      return isSignedIn() &&
        ( isAdmin() || myDoc().get('canAddQuestions', true) == true );
    }
    match /users/{userId} {
      allow read: if isSignedIn();
      // Ro'yxatdan o'tishda: role har doim "user", lekin
      // ruxsat maydonlari (canAddQuestions va h.k.) true
      // bo'lib yaratilishi mumkin — bu standart baza, imtiyoz emas.
      allow create: if isSignedIn() && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      // Yangilash: foydalanuvchi o'zini yangilaydi, LEKIN
      // 5 ta "boshqaruv" maydonini (role + 4 ta ruxsat)
      // o'zgartira olmaydi — faqat admin o'zgartira oladi.
      allow update: if isSignedIn() && (
                      ( request.auth.uid == userId
                        && request.resource.data.get('role','user') == resource.data.get('role','user')
                        && request.resource.data.get('canAddQuestions', true) == resource.data.get('canAddQuestions', true)
                        && request.resource.data.get('canEditTopics', true) == resource.data.get('canEditTopics', true)
                        && request.resource.data.get('canAddParticipants', true) == resource.data.get('canAddParticipants', true)
                        && request.resource.data.get('canSetParticipantImage', true) == resource.data.get('canSetParticipantImage', true)
                      )
                      || isAdmin()
                    );
      allow delete: if isSignedIn() && request.auth.uid == userId;
      match /topics/{topicId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
      match /gameHistory/{historyId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    match /sharedTopics/{topicId} {
      allow read: if true;
      allow write: if canManageTopics();
    }
    // Umumiy dastur sozlamalari (bepul limitlar, Live Quiz
    // Arena banneri — orqa fon rasmi va matnlari — va h.k.)
    // — hamma login qilgan foydalanuvchi (mehmonlar ham,
    // chunki ular ham anonim autentifikatsiya orqali
    // "signed in" hisoblanadi) o'qiy oladi, lekin FAQAT
    // admin yoza oladi (admin.html "Limitlar" bo'limi va
    // game.html'dagi banner tahrirlash tugmasi).
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Foydalanuvchi murojaatlari (support / "Bog'lanish"):
    // - Yaratish: har qanday login qilgan foydalanuvchi,
    //   FAQAT o'z uid'i bilan (boshqa birovning nomidan
    //   xabar yubora olmaydi).
    // - O'qish: admin BARCHASINI, oddiy foydalanuvchi esa
    //   FAQAT o'ziga tegishli xabarlarni ko'radi.
    // - Yangilash: admin xohlagan maydonni (javob va h.k.)
    //   o'zgartira oladi; oddiy foydalanuvchi esa FAQAT
    //   o'z xabarida "dismissedByUser" maydonini o'zgartira
    //   oladi (javob bildirishnomasini yopish uchun) — boshqa
    //   hech narsani o'zgartira olmaydi.
    // - O'chirish: FAQAT admin (ro'yxat to'lib ketmasligi
    //   uchun).
    match /supportMessages/{messageId} {
      allow read: if isSignedIn() &&
        (isAdmin() || resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn() && (
        isAdmin() ||
        ( resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.message == resource.data.message &&
          request.resource.data.adminReply == resource.data.adminReply
        )
      );

      allow delete: if isAdmin();
    }
    match /rooms/{roomCode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
      match /players/{playerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isSignedIn() && (
                        resource.data.uid == request.auth.uid ||
                        get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
                      );
        allow delete: if isSignedIn()
                      && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;
      }
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 300
                      && request.resource.data.name is string
                      && request.resource.data.createdAt is number;
        allow update, delete: if false;
      }
    }
  }
}
